+    def test_source_peek_does_not_subscribe(self):
+        a, b = Source('a', 1), Source('b', 2)
+        c = Computed(lambda read: read(a) + b.peek())
+        self.assertEqual(c.value, 3)
+        self.assertEqual(b._subscribers, [])
+        b.set(10)
+        self.assertEqual(c.value, 3)
+
+    def test_computed_peek_returns_cached_value(self):
+        a = Source('a', 1)
+        c = Computed(lambda read: read(a) * 2)
+        self.assertIsNone(c.peek())
